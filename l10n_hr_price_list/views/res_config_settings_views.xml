<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_price_list" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.price.list</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <block title="Public Price List" id="l10n_hr_price_list">
                    <setting id="price_list_locations" string="Public Price List Premises"
                             company_dependent="1"
                             help="Consumer price list with the additional price (CSV, NN 101/26), per premises.">
                        <div class="mt8">
                            <button name="%(action_price_list_location)d" type="action" string="Manage premises"
                                    icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
