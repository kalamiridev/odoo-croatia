<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="price_list_version_view_list" model="ir.ui.view">
        <field name="name">l10n_hr.price.list.version.list</field>
        <field name="model">l10n_hr.price.list.version</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="location_id"/>
                <field name="number"/>
                <field name="name"/>
                <field name="published_at"/>
                <field name="line_count"/>
                <field name="is_current" widget="boolean"/>
                <field name="webhook_state" widget="badge" invisible="webhook_state == 'none'"
                       decoration-success="webhook_state == 'sent'"
                       decoration-warning="webhook_state == 'pending'"
                       decoration-danger="webhook_state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="price_list_version_view_form" model="ir.ui.view">
        <field name="name">l10n_hr.price.list.version.form</field>
        <field name="model">l10n_hr.price.list.version</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id"/>
                            <field name="number"/>
                            <field name="published_at"/>
                            <field name="line_count"/>
                            <field name="is_current"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="file" filename="name"/>
                            <field name="url" widget="url"/>
                            <field name="webhook_state" invisible="webhook_state == 'none'"/>
                            <field name="webhook_sent_at" invisible="not webhook_sent_at"/>
                            <field name="webhook_error" invisible="not webhook_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_price_list_version" model="ir.actions.act_window">
        <field name="name">Public Price List</field>
        <field name="res_model">l10n_hr.price.list.version</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No price list published yet</p>
            <p>A version is published a minute after a premises is saved.</p>
        </field>
    </record>
</odoo>
